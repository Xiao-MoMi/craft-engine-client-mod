{
  "schemaVersion": 1,
  "id": "craftengine",
  "version": "${version}",
  "name": "CraftEngine Client Mod",
  "description": "CraftEngine Client Mod",
  "authors": [
    "jhqwqmc"
  ],
  "contact": {
    "name": "CraftEngine",
    "homepage": "https://github.com/Xiao-MoMi/craft-engine-client-mod",
    "issues": "https://github.com/Xiao-MoMi/craft-engine-client-mod/issues"
  },
  "license": "GPL-3.0",
  "icon": "assets/craftengine/icon.png",
  "environment": "client",
  "entrypoints": {
    "main": ["net.momirealms.craftengine.fabric.CraftEngineFabricMod"],
    "modmenu": ["net.momirealms.craftengine.fabric.config.ModMenuIntegration"]
  },
  "mixins": [
    "craftengine.mixins.json"
  ],
  "depends": {
    "fabricloader": "*",
    "fabric": "*",
    "minecraft": ">=${min_minecraft_version} <=${max_minecraft_version}",
    "fabric-api": "*"
  },
  "accessWidener": "craftengine.accesswidener"
}
